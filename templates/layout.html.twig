{% extends 'cms/layout_base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('bundles/shoprothemeatenafit/hero.css') }}">
{% endblock %}

{% block site_header %}
<header class="atena-header">
    <div class="atena-container atena-header__inner">
        {% set configured_logo = shopro_setting('site_logo') %}
        {% set atena_fallback_logo = asset('bundles/shoprothemeatenafit/atena-fit-logo.svg') %}
        <a class="atena-brand" href="{{ path('app_home') }}" aria-label="Atena Fit — strona główna">
            <img src="{{ configured_logo ?: atena_fallback_logo }}" alt="{{ shopro_setting('site_name', 'Atena Fit') }}"{% if configured_logo %} onerror="this.onerror=null;this.src='{{ atena_fallback_logo|e('js') }}'"{% endif %}>
        </a>
        <nav class="atena-nav" aria-label="{{ shopro_trans('front.main_menu') }}">
            {% set header_menu = shopro_menu(1) %}
            {% if header_menu %}
                {% for item in header_menu %}
                    {% if item.url %}<a href="{{ item.url }}" target="{{ item.target }}"{{ item.target == '_blank' ? ' rel="noopener noreferrer"' : '' }}>{{ item.name }}</a>{% endif %}
                {% endfor %}
            {% else %}
                <a href="#cennik">Cennik</a><a href="#jak-zaczac">Jak zacząć?</a><a href="#aplikacja">Aplikacja</a><a href="#atena-fit">Poznaj Atena Fit</a><a href="#sprzet">Sprzęt</a><a href="#kontakt">Kontakt</a>
            {% endif %}
        </nav>
        <a class="atena-button atena-button--small" href="#kontakt">Zacznij teraz <span aria-hidden="true">›</span></a>
    </div>
</header>
{% endblock %}

{% block site_footer %}
<footer class="atena-footer">
    {% set configured_logo = shopro_setting('site_logo') %}
    {% set atena_fallback_logo = asset('bundles/shoprothemeatenafit/atena-fit-logo.svg') %}
    {% set footer_menu = shopro_menu(0)|default([]) %}
    {% set footer_phone = shopro_setting('contact_phone', '+48 123 456 789') %}
    {% set footer_email = shopro_setting('contact_email', 'kontakt@atenafit.pl') %}
    {% set footer_address = shopro_setting('contact_address', 'Trzciana 234<br>39-321 Trzciana') %}
    {% set footer_hours = shopro_setting('opening_hours', 'Całodobowo<br>7 dni w tygodniu') %}
    <div class="atena-container atena-footer__grid">
        <div class="atena-footer__brand-column">
            <a class="atena-footer__brand" href="{{ path('app_home') }}" aria-label="{{ shopro_setting('site_name', 'Atena Fit') }} — strona główna">
                <img src="{{ configured_logo ?: atena_fallback_logo }}" alt="{{ shopro_setting('site_name', 'Atena Fit') }}"{% if configured_logo %} onerror="this.onerror=null;this.src='{{ atena_fallback_logo|e('js') }}'"{% endif %}>
            </a>
            <div class="atena-footer__socials" aria-label="Media społecznościowe">
                <a href="{{ shopro_setting('social_facebook', '#') }}" aria-label="Facebook"{% if shopro_setting('social_facebook', '') %} target="_blank" rel="noopener noreferrer"{% endif %}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.8 21v-8h2.7l.4-3.1h-3.1V7.92c0-.9.25-1.51 1.55-1.51H17V3.63c-.3-.04-1.3-.13-2.48-.13-2.45 0-4.13 1.5-4.13 4.25V9.9H7.62V13h2.77v8h3.41Z"/></svg></a>
                <a href="{{ shopro_setting('social_instagram', '#') }}" aria-label="Instagram"{% if shopro_setting('social_instagram', '') %} target="_blank" rel="noopener noreferrer"{% endif %}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" class="atena-footer__social-fill"/></svg></a>
                <a href="{{ shopro_setting('social_tiktok', '#') }}" aria-label="TikTok"{% if shopro_setting('social_tiktok', '') %} target="_blank" rel="noopener noreferrer"{% endif %}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3v10.2a3.7 3.7 0 1 1-3-3.63V6.3a7 7 0 1 0 6.4 6.98V8.83c1.06.89 2.36 1.45 3.7 1.58V7.15A4.25 4.25 0 0 1 17.2 3H14Z"/></svg></a>
            </div>
        </div>
        <nav class="atena-footer__column" aria-label="Menu stopki">
            <h2>Menu</h2>
            {% if footer_menu %}
                {% for item in footer_menu %}{% if item.url %}<a href="{{ item.url }}" target="{{ item.target }}"{{ item.target == '_blank' ? ' rel="noopener noreferrer"' : '' }}>{{ item.name }}</a>{% endif %}{% endfor %}
            {% else %}
                <a href="#cennik">Cennik</a><a href="#jak-zaczac">Jak zacząć?</a><a href="#aplikacja">Aplikacja</a><a href="#atena-fit">Poznaj Atena Fit</a><a href="#sprzet">Sprzęt</a><a href="#kontakt">Kontakt</a>
            {% endif %}
        </nav>
        <nav class="atena-footer__column" aria-label="Informacje">
            <h2>Informacje</h2>
            <a href="/regulamin">Regulamin</a>
            <a href="/polityka-prywatnosci">Polityka prywatności</a>
        </nav>
        <address class="atena-footer__column atena-footer__contact">
            <h2>Kontakt</h2>
            <a href="tel:{{ footer_phone|replace({' ': '', '-': ''}) }}"><span class="atena-footer__contact-icon">⌕</span>{{ footer_phone }}</a>
            <a href="mailto:{{ footer_email }}"><span class="atena-footer__contact-icon">✉</span>{{ footer_email }}</a>
            <p><span class="atena-footer__contact-icon">●</span>{{ footer_address|raw }}</p>
        </address>
        <div class="atena-footer__hours">
            <div><h2>Godziny otwarcia</h2><p>{{ footer_hours|raw }}</p></div>
            <strong aria-label="Dostęp 24 godziny na dobę, 7 dni w tygodniu">24<span>/7</span></strong>
        </div>
    </div>
    <div class="atena-container atena-footer__bottom">© {{ 'now'|date('Y') }} {{ shopro_setting('site_name', 'Atena Fit') }} – Siłownia Trzciana. Wszystkie prawa zastrzeżone.</div>
</footer>
{% endblock %}
