<section class="atena-section atena-pricing" id="cennik"><div class="atena-container"><h2>{{ block.heading|default('Cennik') }}</h2><p>{{ block.intro|default('') }}</p><div class="atena-pricing__grid">{% for plan in block.items|default([]) %}<article class="atena-plan{{ plan.badge|default ? ' atena-plan--featured' : '' }}">{% if plan.badge|default %}<span>{{ plan.badge }}</span>{% endif %}<h3>{{ plan.name|default('') }}</h3><strong>{{ plan.price|default('') }}</strong><p>{{ plan.description|default('') }}</p><a href="{{ plan.url|default('#') }}">Kup teraz</a></article>{% endfor %}</div></div></section>
