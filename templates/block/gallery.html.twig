<section class="atena-section atena-gallery"><div class="atena-container"><h2>{{ block.heading|default('Poznaj Atena Fit') }}</h2><div class="atena-gallery__grid">{% for item in block.items|default([]) %}<article{% if item.image|default %} style="background-image:url('{{ item.image|e('html_attr') }}')"{% endif %}><h3>{{ item.name|default('') }}</h3></article>{% endfor %}</div></div></section>
