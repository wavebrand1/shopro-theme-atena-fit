{% set default_features = [
    {title: 'Nowoczesny sprzęt', text: 'Strefa siłowa, cardio, funkcjonalna i więcej.', icon: 'equipment'},
    {title: 'Przyjazna atmosfera', text: 'Bez presji, bez oceniania. Tu liczy się Ty.', icon: 'user'},
    {title: 'Dostęp 24/7', text: 'Trenuj, kiedy chcesz. Zawsze, gdy masz czas.', icon: 'clock'}
] %}
{% set stored_features = block.items|default([]) %}
{% set features = [] %}
{% for feature in default_features %}
    {% set features = features|merge([feature|merge(stored_features[loop.index0]|default({}))]) %}
{% endfor %}
{% set default_main_image = asset('bundles/shoprothemeatenafit/atena-story-main-default.png') %}
{% set default_community_image = asset('bundles/shoprothemeatenafit/atena-story-community-default.png') %}
{% set story_heading = block.heading is defined ? block.heading : 'Każda zmiana zaczyna się od' %}
{% if story_heading == 'Każda zmiana zaczyna się od jednej decyzji.' %}{% set story_heading = 'Każda zmiana zaczyna się od' %}{% endif %}
{% set default_content = '<p>Niezależnie od tego, czy chcesz schudnąć, poprawić kondycję, zbudować siłę, wrócić do aktywności po długiej przerwie czy po prostu zadbać o swoje zdrowie — najtrudniejszy jest pierwszy krok.</p><p>W Atena Fit stworzyliśmy miejsce, do którego możesz wejść bez presji i trenować we własnym tempie. Nowoczesny sprzęt, komfortowa przestrzeń i prosty dostęp sprawiają, że możesz skupić się wyłącznie na swoim celu.</p>' %}
{% set story_content = block.content is defined ? block.content : default_content %}
{% if story_content == '<p>Nie musisz być w formie, żeby zacząć.</p>' %}{% set story_content = default_content %}{% endif %}

<section class="atena-story" id="{{ block.anchor|default('o-nas') }}">
    <div class="atena-container atena-story__layout">
        <div class="atena-story__copy">
            <p class="atena-story__eyebrow">{{ block.eyebrow is defined ? block.eyebrow : 'Zrób pierwszy krok' }}</p>
            <h2>{{ story_heading }} <em>{{ block.highlight is defined ? block.highlight : 'jednej decyzji.' }}</em></h2>
            <div class="atena-story__lead">
                <p>{{ block.lead is defined ? block.lead : 'Nie musisz być w formie, żeby zacząć.' }}</p>
                <p>{{ block.leadHighlight is defined ? block.leadHighlight : 'Musisz zacząć, żeby zbudować formę.' }}</p>
            </div>
            <div class="atena-story__content">{{ story_content|raw }}</div>
            <div class="atena-story__promise">
                <span aria-hidden="true">♙</span>
                <p>{{ block.promise is defined ? block.promise : 'Za kilka miesięcy możesz wyglądać i czuć się' }} <strong>{{ block.promiseHighlight is defined ? block.promiseHighlight : 'zupełnie inaczej.' }}</strong> {{ block.promiseEnding is defined ? block.promiseEnding : 'Wszystko zaczyna się od jednej wizyty.' }}</p>
            </div>
            <div class="atena-story__actions">
                {% if block.buttonLabel|default %}<a class="atena-button" href="{{ block.url|default('#kontakt') }}">{{ block.buttonLabel }} <span>›</span></a>{% endif %}
                <div class="atena-story__schedule"><span aria-hidden="true">▣</span><p><strong>{{ block.scheduleTitle is defined ? block.scheduleTitle : 'Trenujesz kiedy chcesz' }}</strong>{{ block.scheduleText is defined ? block.scheduleText : 'Dostęp 24/7, bez ograniczeń' }}</p></div>
            </div>
        </div>

        <div class="atena-story__visuals">
            <figure class="atena-story__main-image">
                {% set main_image = block.image|default(default_main_image) %}
                {% if 'bundles/' in main_image %}
                    {{ shopro_theme_picture(main_image, block.imageAlt is defined ? block.imageAlt : 'Trening w Atena Fit', 'atena-story__image', false, '(max-width: 840px) 100vw, 52vw') }}
                {% else %}
                    {{ shopro_picture(main_image, block.imageAlt is defined ? block.imageAlt : 'Trening w Atena Fit', null, null, false, '(max-width: 840px) 100vw, 52vw') }}
                {% endif %}
                <figcaption><span class="atena-story__mark">A</span><strong>{{ block.cardLine1 is defined ? block.cardLine1 : 'Twoje cele.' }}<br>{{ block.cardLine2 is defined ? block.cardLine2 : 'Twoja droga.' }}</strong><i></i><strong>{{ block.cardLine3 is defined ? block.cardLine3 : 'My dajemy' }}<br><em>{{ block.cardHighlight is defined ? block.cardHighlight : 'przestrzeń.' }}</em></strong></figcaption>
            </figure>
            <div class="atena-story__bottom-row">
                <figure class="atena-story__community-image">
                    {% set community_image = block.secondaryImage|default(default_community_image) %}
                    {% if 'bundles/' in community_image %}
                        {{ shopro_theme_picture(community_image, block.secondaryImageAlt is defined ? block.secondaryImageAlt : 'Społeczność Atena Fit', 'atena-story__image', false, '(max-width: 840px) 100vw, 34vw') }}
                    {% else %}
                        {{ shopro_picture(community_image, block.secondaryImageAlt is defined ? block.secondaryImageAlt : 'Społeczność Atena Fit', null, null, false, '(max-width: 840px) 100vw, 34vw') }}
                    {% endif %}
                </figure>
                <div class="atena-story__features">
                    {% for feature in features %}
                        <article>
                            <span class="atena-story__feature-icon" aria-hidden="true">
                                {% if feature.icon|default('equipment') == 'user' %}♙{% elseif feature.icon|default('equipment') == 'clock' %}◷{% else %}▰{% endif %}
                            </span>
                            <p><strong>{{ feature.title|default('') }}</strong>{{ feature.text|default('') }}</p>
                        </article>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</section>
