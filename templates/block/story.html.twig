<section class="atena-section atena-story"><div class="atena-container atena-story__grid"><div><p class="atena-kicker">{{ block.eyebrow|default('') }}</p><h2>{{ block.heading|default('') }}</h2><div>{{ block.content|default('')|raw }}</div>{% if block.buttonLabel|default %}<a class="atena-button" href="{{ block.url|default('#') }}">{{ block.buttonLabel }} <span>›</span></a>{% endif %}</div>{% if block.image|default %}<img src="{{ block.image }}" alt="" loading="lazy">{% endif %}</div></section>
