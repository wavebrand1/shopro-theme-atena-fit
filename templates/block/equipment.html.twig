{% set defaults = [
    { name: 'Hammer Strength Chest Press', text: 'Maszyna do wyciskania na klatkę piersiową', image: asset('bundles/shoprothemeatenafit/atena-equipment-chestpress-default.webp') },
    { name: 'Technogym Run Personal', text: 'Bieżnia elektromagnetyczna', image: asset('bundles/shoprothemeatenafit/atena-equipment-treadmill-default.webp') },
    { name: 'Matrix Lat Pulldown', text: 'Maszyna do ściągania drążka górnego', image: asset('bundles/shoprothemeatenafit/atena-equipment-pulldown-default.webp') },
    { name: 'Life Fitness Squat Rack', text: 'Klatka do przysiadów z asekuracją', image: asset('bundles/shoprothemeatenafit/atena-equipment-squatrack-default.webp') },
    { name: 'Concept2 RowErg', text: 'Wioślarz powietrzny', image: asset('bundles/shoprothemeatenafit/atena-equipment-rower-default.webp') }
] %}
{% set items = block.items|default([]) %}
{% set total = defaults|length %}
{% if items|length > total %}{% set total = items|length %}{% endif %}

<section class="atena-equipment"{% if block.anchor|default %} id="{{ block.anchor }}"{% endif %}>
    <div class="atena-equipment__intro">
        <h2>{{ block.heading is defined ? block.heading : 'Sprzęt' }}<span aria-hidden="true"></span></h2>
        <p>{{ block.description is defined ? block.description : 'Najwyższej klasy urządzenia od najlepszych marek.' }}</p>
        {% set button_label = block.buttonLabel is defined ? block.buttonLabel : 'Zobacz wszystkie sprzęty' %}
        {% if button_label|trim %}<a class="atena-equipment__button" href="{{ block.url|default('#kontakt') }}">
            {{ button_label }} <span aria-hidden="true">›</span>
        </a>{% endif %}
    </div>

    <div class="atena-carousel atena-equipment__carousel" data-atena-carousel aria-label="{{ block.heading is defined ? block.heading : 'Sprzęt' }}">
        <button class="atena-carousel__control atena-carousel__control--previous" type="button" data-atena-carousel-previous aria-label="Poprzednie urządzenia">‹</button>
        <div class="atena-carousel__viewport" data-atena-carousel-viewport tabindex="0">
            <div class="atena-carousel__track">
                {% for index in 0..(total - 1) %}
                    {% set fallback = defaults[index]|default({ name: '', text: '', image: '' }) %}
                    {% set item = items[index]|default({}) %}
                    <article class="atena-equipment__card">
                        <div class="atena-equipment__image">
                            {% set image = item.image|default(fallback.image) %}
                            {% if 'bundles/' in image %}
                                {{ shopro_theme_picture(image, item.name is defined ? item.name : fallback.name, 'atena-equipment__asset', false, '(max-width: 500px) 100vw, (max-width: 820px) 50vw, 20vw') }}
                            {% else %}
                                {{ shopro_picture(image, item.name is defined ? item.name : fallback.name, null, null, false, '(max-width: 500px) 100vw, (max-width: 820px) 50vw, 20vw') }}
                            {% endif %}
                        </div>
                        <h3>{{ item.name is defined ? item.name : fallback.name }}</h3>
                        <p>{{ item.text is defined ? item.text : fallback.text }}</p>
                    </article>
                {% endfor %}
            </div>
        </div>
        <button class="atena-carousel__control atena-carousel__control--next" type="button" data-atena-carousel-next aria-label="Następne urządzenia">›</button>
    </div>
</section>
