<section class="atena-section atena-equipment"><div class="atena-container"><h2>{{ block.heading|default('Sprzęt') }}</h2><div class="atena-equipment__grid">{% for item in block.items|default([]) %}<article>{% if item.image|default %}<img src="{{ item.image }}" alt="" loading="lazy">{% endif %}<h3>{{ item.name|default('') }}</h3><p>{{ item.text|default('') }}</p></article>{% endfor %}</div></div></section>
