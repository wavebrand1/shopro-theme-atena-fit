{% set default_screens = [
    { image: asset('bundles/shoprothemeatenafit/atena-app-screen-membership-default.png'), alt: 'Aplikacja Atena Fit — moje karnety' },
    { image: asset('bundles/shoprothemeatenafit/atena-app-screen-entry-default.png'), alt: 'Aplikacja Atena Fit — mobilny kod wejścia' },
    { image: asset('bundles/shoprothemeatenafit/atena-app-screen-shop-default.png'), alt: 'Aplikacja Atena Fit — sklep karnetów' },
    { image: asset('bundles/shoprothemeatenafit/atena-app-screen-statistics-default.png'), alt: 'Aplikacja Atena Fit — statystyki aktywności' }
] %}
{% set screens = block.items|default([]) %}
{% set default_benefits = [
    'Zakup i zarządzanie karnetami',
    'Historia wejść i aktywności',
    'Udostępnianie karnetu',
    'Powiadomienia i aktualności',
    'Szybkie otwieranie drzwi'
] %}

<section class="atena-section atena-app"{% if block.anchor|default('') %} id="{{ block.anchor }}"{% endif %}>
    <div class="atena-container atena-app__layout">
        <div class="atena-app__copy">
            <p class="atena-app__eyebrow">{{ block.eyebrow is defined ? block.eyebrow : 'Aplikacja' }}</p>
            <h2>{{ block.heading is defined ? block.heading : 'Wszystko w Twoim telefonie' }}</h2>
            <p class="atena-app__intro">{{ block.intro is defined ? block.intro : 'Aplikacja Atena Fit daje Ci pełną kontrolę nad Twoim dostępem do siłowni.' }}</p>

            <ul class="atena-app__benefits">
                {% for default_benefit in default_benefits %}
                    {% set benefit_key = 'benefit' ~ loop.index %}
                    {% set benefit = attribute(block, benefit_key) is defined ? attribute(block, benefit_key) : default_benefit %}
                    {% if benefit %}
                        <li><span aria-hidden="true">✓</span>{{ benefit }}</li>
                    {% endif %}
                {% endfor %}
            </ul>

            <div class="atena-app__stores">
                {% set app_store_label = block.appStoreLabel is defined ? block.appStoreLabel : 'App Store' %}
                {% if app_store_label|trim %}<a class="atena-store-badge" href="{{ block.appStoreUrl|default('#') }}"{% if block.appStoreUrl|default('') starts with 'http' %} target="_blank" rel="noopener noreferrer"{% endif %} aria-label="{{ app_store_label }}">
                    <img class="atena-store-badge__icon" src="{{ asset('bundles/shoprothemeatenafit/appstore.svg') }}" alt="">
                    <span class="atena-store-badge__copy"><small>{{ block.appStoreOverline is defined ? block.appStoreOverline : 'Pobierz w' }}</small><strong>{{ app_store_label }}</strong></span>
                </a>{% endif %}
                {% set google_play_label = block.googlePlayLabel is defined ? block.googlePlayLabel : 'Google Play' %}
                {% if google_play_label|trim %}<a class="atena-store-badge" href="{{ block.googlePlayUrl|default('#') }}"{% if block.googlePlayUrl|default('') starts with 'http' %} target="_blank" rel="noopener noreferrer"{% endif %} aria-label="{{ google_play_label }}">
                    <img class="atena-store-badge__icon" src="{{ asset('bundles/shoprothemeatenafit/googleplay.svg') }}" alt="">
                    <span class="atena-store-badge__copy"><small>{{ block.googlePlayOverline is defined ? block.googlePlayOverline : 'Pobierz z' }}</small><strong>{{ google_play_label }}</strong></span>
                </a>{% endif %}
            </div>
        </div>

        <div class="atena-app__screens" aria-label="Ekrany aplikacji Atena Fit">
            {% for fallback in default_screens %}
                {% set screen = screens[loop.index0]|default({}) %}
                <figure class="atena-app__screen">
                    <div class="atena-phone">
                        <div class="atena-phone__viewport">
                            {% set image = screen.image|default(fallback.image) %}
                            {% if 'bundles/' in image %}
                                {{ shopro_theme_picture(image, screen.alt is defined ? screen.alt : fallback.alt, 'atena-phone__display', false, '(max-width: 620px) 42vw, 18vw') }}
                            {% else %}
                                {{ shopro_picture(image, screen.alt is defined ? screen.alt : fallback.alt, null, null, false, '(max-width: 620px) 42vw, 18vw') }}
                            {% endif %}
                        </div>
                        <img class="atena-phone__frame" src="{{ asset('bundles/shoprothemeatenafit/atena-phone-frame.png') }}" alt="" aria-hidden="true">
                    </div>
                </figure>
            {% endfor %}
        </div>
    </div>
</section>
