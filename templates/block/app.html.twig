{% set default_screens = [
    { image: asset('bundles/shoprothemeatenafit/atena-app-screen-membership-default.png'), alt: 'Aplikacja Atena Fit — moje karnety' },
    { image: asset('bundles/shoprothemeatenafit/atena-app-screen-entry-default.png'), alt: 'Aplikacja Atena Fit — mobilny kod wejścia' },
    { image: asset('bundles/shoprothemeatenafit/atena-app-screen-shop-default.png'), alt: 'Aplikacja Atena Fit — sklep karnetów' },
    { image: asset('bundles/shoprothemeatenafit/atena-app-screen-statistics-default.png'), alt: 'Aplikacja Atena Fit — statystyki aktywności' }
] %}
{% set screens = block.items|default([]) %}
{% set default_benefits = [
    'Zakup i zarządzanie karnetami',
    'Historia wejść i aktywności',
    'Udostępnianie karnetu',
    'Powiadomienia i aktualności',
    'Szybkie otwieranie drzwi'
] %}

<section class="atena-section atena-app"{% if block.anchor|default('') %} id="{{ block.anchor }}"{% endif %}>
    <div class="atena-container atena-app__layout">
        <div class="atena-app__copy">
            <p class="atena-app__eyebrow">{{ block.eyebrow|default('Aplikacja') }}</p>
            <h2>{{ block.heading|default('Wszystko w Twoim telefonie') }}</h2>
            <p class="atena-app__intro">{{ block.intro|default('Aplikacja Atena Fit daje Ci pełną kontrolę nad Twoim dostępem do siłowni.') }}</p>

            <ul class="atena-app__benefits">
                {% for default_benefit in default_benefits %}
                    {% set benefit = attribute(block, 'benefit' ~ loop.index)|default(default_benefit, true) %}
                    {% if benefit %}
                        <li><span aria-hidden="true">✓</span>{{ benefit }}</li>
                    {% endif %}
                {% endfor %}
            </ul>

            <div class="atena-app__stores">
                <a class="atena-store-badge" href="{{ block.appStoreUrl|default('#') }}"{% if block.appStoreUrl|default('') starts with 'http' %} target="_blank" rel="noopener noreferrer"{% endif %} aria-label="{{ block.appStoreLabel|default('Pobierz w App Store') }}">
                    <img class="atena-store-badge__icon" src="{{ asset('bundles/shoprothemeatenafit/appstore.svg') }}" alt="">
                    <span class="atena-store-badge__copy"><small>{{ block.appStoreOverline|default('Pobierz w') }}</small><strong>{{ block.appStoreLabel|default('App Store') }}</strong></span>
                </a>
                <a class="atena-store-badge" href="{{ block.googlePlayUrl|default('#') }}"{% if block.googlePlayUrl|default('') starts with 'http' %} target="_blank" rel="noopener noreferrer"{% endif %} aria-label="{{ block.googlePlayLabel|default('Pobierz z Google Play') }}">
                    <img class="atena-store-badge__icon" src="{{ asset('bundles/shoprothemeatenafit/googleplay.svg') }}" alt="">
                    <span class="atena-store-badge__copy"><small>{{ block.googlePlayOverline|default('Pobierz z') }}</small><strong>{{ block.googlePlayLabel|default('Google Play') }}</strong></span>
                </a>
            </div>
        </div>

        <div class="atena-app__screens" aria-label="Ekrany aplikacji Atena Fit">
            {% for fallback in default_screens %}
                {% set screen = screens[loop.index0]|default({}) %}
                <figure class="atena-app__screen">
                    <div class="atena-phone">
                        <div class="atena-phone__viewport">
                            <img class="atena-phone__display" src="{{ screen.image|default(fallback.image) }}" alt="{{ screen.alt|default(fallback.alt) }}" loading="lazy">
                        </div>
                        <img class="atena-phone__frame" src="{{ asset('bundles/shoprothemeatenafit/atena-phone-frame.png') }}" alt="" aria-hidden="true">
                    </div>
                </figure>
            {% endfor %}
        </div>
    </div>
</section>
