<section class="atena-section atena-app"><div class="atena-container atena-app__grid"><div><p class="atena-kicker">{{ block.eyebrow|default('') }}</p><h2>{{ block.heading|default('') }}</h2><div>{{ block.content|default('')|raw }}</div></div><div class="atena-app__screens">{% for item in block.items|default([]) %}{% if item.image|default %}<img src="{{ item.image }}" alt="{{ item.alt|default('') }}" loading="lazy">{% endif %}{% endfor %}</div></div></section>
