<section class="atena-cta"{% if block.image|default %} style="--atena-cta-image:url('{{ block.image|e('html_attr') }}')"{% endif %}><div class="atena-container"><h2>{{ block.heading|default('') }}</h2><div>{{ block.content|default('')|raw }}</div>{% if block.buttonLabel|default %}<a class="atena-button" href="{{ block.url|default('#') }}">{{ block.buttonLabel }} <span>›</span></a>{% endif %}</div></section>
