{% set default_image = asset('bundles/shoprothemeatenafit/atena-cta-default.webp') %}
{% set default_mark = asset('bundles/shoprothemeatenafit/atena-fit-mark.svg') %}
{% set watermark = block.watermark|default(block.watermarkImage|default(default_mark)) %}
{% set image = block.image|default(default_image) %}

<section class="atena-cta"{% if block.anchor|default %} id="{{ block.anchor }}"{% endif %}>
    <div class="atena-cta__background" aria-hidden="true">
        {% if 'bundles/' in image %}
            {{ shopro_theme_picture(image, '', 'atena-cta__background-image', false, '100vw') }}
        {% else %}
            {{ shopro_picture(image, '', null, null, false, '100vw') }}
        {% endif %}
    </div>
    {% if watermark starts with '/uploads/' %}
        <span class="atena-cta__watermark" aria-hidden="true">{{ shopro_picture(watermark, '', null, null, false, '205px') }}</span>
    {% else %}
        <img class="atena-cta__watermark" src="{{ watermark }}" alt="" aria-hidden="true" loading="lazy" decoding="async">
    {% endif %}
    <div class="atena-container atena-cta__inner">
        <div class="atena-cta__content">
            <h2>{{ block.heading is defined ? block.heading : 'Gotowy na zmianę?' }}</h2>
            <p>{{ block.description is defined ? block.description : (block.content is defined ? block.content|striptags : 'Dołącz do Atena Fit i zacznij trenować już dziś.') }}</p>
            {% if block.buttonLabel|default %}
                <a class="atena-button atena-cta__button" href="{{ block.url|default('#kontakt') }}">{{ block.buttonLabel }} <span aria-hidden="true">›</span></a>
            {% endif %}
        </div>
    </div>
</section>
