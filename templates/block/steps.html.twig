{% set default_steps = [
    {title: 'Pobierz aplikację', text: 'Pobierz aplikację Atena Fit z App Store lub Google Play.', icon: 'phone', color: 'red'},
    {title: 'Załóż konto', text: 'Zarejestruj się w aplikacji i zweryfikuj swój numer telefonu.', icon: 'user', color: 'blue'},
    {title: 'Kup karnet', text: 'Wybierz karnet i dokonaj płatności w aplikacji.', icon: 'card', color: 'red'},
    {title: 'Wejdź i trenuj', text: 'Otwórz drzwi aplikacją i ciesz się treningiem!', icon: 'door', color: 'blue'}
] %}
{% set stored_steps = block.items|default([]) %}
{% set steps = [] %}
{% for default_step in default_steps %}
    {% set stored_step = stored_steps[loop.index0]|default({}) %}
    {# Upgrade values stored by the first, simplified version of this component. #}
    {% if stored_step.text|default('') in ['Pobierz aplikację Atena Fit.', 'Zarejestruj się.', 'Wybierz pakiet.', 'Otwórz drzwi aplikacją.'] %}
        {% set stored_step = stored_step|merge({text: default_step.text}) %}
    {% endif %}
    {% set steps = steps|merge([default_step|merge(stored_step)]) %}
{% endfor %}
{% set default_image = asset('bundles/shoprothemeatenafit/atena-steps-default.png') %}

<section class="atena-steps" id="{{ block.anchor|default('jak-zaczac') }}">
    <div class="atena-steps__layout">
        <div class="atena-steps__content">
            <div class="atena-steps__content-inner">
                <header class="atena-steps__heading">
                    <h2>{{ block.heading|default('Jak zacząć?') }}</h2>
                    <p>{{ block.intro|default('4 proste kroki do Twojego pierwszego treningu.') }}</p>
                </header>

                <div class="atena-steps__flow">
                    {% for step in steps %}
                        {% set icon = step.icon|default('phone') %}
                        {% set color = step.color|default(loop.index is even ? 'blue' : 'red') %}
                        <article class="atena-step atena-step--{{ color }}">
                            <span class="atena-step__number">{{ loop.index }}</span>
                            <span class="atena-step__icon" aria-hidden="true">
                                <svg viewBox="0 0 48 48" fill="none">
                                    {% if icon == 'user' %}
                                        <circle cx="24" cy="16" r="7" stroke="currentColor" stroke-width="2.4"/>
                                        <path d="M10 39c1.8-8 7-12 14-12s12.2 4 14 12" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
                                    {% elseif icon == 'card' %}
                                        <rect x="8" y="12" width="32" height="24" rx="3" stroke="currentColor" stroke-width="2.4"/>
                                        <path d="M9 19h30M15 29h8" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
                                    {% elseif icon == 'door' %}
                                        <path d="M13 39V10h19v29M19 39V14h13v25M27 26h.1" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                                    {% else %}
                                        <rect x="15" y="6" width="18" height="36" rx="3" stroke="currentColor" stroke-width="2.4"/>
                                        <path d="M22 36h4" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
                                    {% endif %}
                                </svg>
                            </span>
                            <h3>{{ step.title|default('') }}</h3>
                            <p>{{ step.text|default('') }}</p>
                        </article>
                    {% endfor %}
                </div>
            </div>
        </div>
        <div class="atena-steps__visual">
            {% set image = block.image|default(default_image) %}
            {% if image starts with '/bundles/' %}
                {{ shopro_theme_picture(image, block.imageAlt|default('Aplikacja Atena Fit na telefonie'), 'atena-steps__image', false, '(max-width: 840px) 100vw, 46vw') }}
            {% else %}
                {{ shopro_picture(image, block.imageAlt|default('Aplikacja Atena Fit na telefonie'), null, null, false, '(max-width: 840px) 100vw, 46vw') }}
            {% endif %}
        </div>
    </div>
</section>
