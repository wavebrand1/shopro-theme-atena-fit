<section class="atena-hero"{% if block.image|default %} style="--atena-hero-image:url('{{ block.image|e('html_attr') }}')"{% endif %}>
    <div class="atena-container atena-hero__content">
        <p class="atena-kicker">{{ block.eyebrow|default('Atena Fit') }}</p>
        <h1>{{ block.heading|default('') }} <em>{{ block.accent|default('') }}</em></h1>
        <div class="atena-hero__copy">{{ block.content|default('')|raw }}</div>
        <div class="atena-actions">{% if block.primaryLabel|default %}<a class="atena-button" href="{{ block.primaryUrl|default('#') }}">{{ block.primaryLabel }} <span>›</span></a>{% endif %}{% if block.secondaryLabel|default %}<a class="atena-button atena-button--ghost" href="{{ block.secondaryUrl|default('#') }}">{{ block.secondaryLabel }}</a>{% endif %}</div>
    </div>
</section>
